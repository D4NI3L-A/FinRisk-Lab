# Copy this file to .env and add the keys for the providers you want to use.
# You only need one. The sidebar shows which keys were found (never the keys themselves).
GEMINI_API_KEY=your-key-here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model for a provider
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-5.6-luna
# DEEPSEEK_MODEL=deepseek-flash
# CLAUDE_MODEL=claude-haiku-5-5
